# Example environment configuration.
# Copy to `.env` and override for your environment. Docker Compose sets the
# service-to-service values itself; these are the knobs you are most likely to change.
# NOTE: never commit a real .env — secrets stay out of Git.

# --- Application ---
APP_NAME="MLOps Platform"
ENVIRONMENT=local                 # local | dev | staging | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR

# --- Database ---
# Postgres is the real target (app + migrations). Tests use in-memory SQLite.
DATABASE_URL=postgresql+psycopg://mlops:mlops@localhost:5432/mlops

# --- Auth / JWT ---
# MUST be overridden in any real deployment. Use a 32+ byte random secret.
JWT_SECRET=dev-insecure-change-me-please-32byte-minimum-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# --- Demo seed data ---
# Password for all seeded demo users (demo convenience only).
DEMO_PASSWORD=demo1234
# Directory holding sample seed data (models.json, metrics.csv). In Docker the
# repo-root data/ folder is mounted and this is set via SEED_DATA_DIR.
# SEED_DATA_DIR=/data
